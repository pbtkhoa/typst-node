{
  "name": "typst-node",
  "version": "1.0.0",
  "description": "High-performance, zero disk I/O programmatic Typst compiler and renderer for Node.js",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbtkhoa/typst-node.git"
  },
  "license": "MIT",
  "author": "Khoa Pham <pbtkhoa@gmail.com>",
  "homepage": "https://github.com/pbtkhoa/typst-node#readme",
  "bugs": {
    "url": "https://github.com/pbtkhoa/typst-node/issues"
  },
  "keywords": [
    "typst",
    "pdf",
    "svg",
    "png",
    "compiler",
    "renderer",
    "typesetting",
    "document-generation",
    "pdf-generator",
    "serverless",
    "napi-rs",
    "rust",
    "node-addon"
  ],
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "typst-node",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:oxfmt format:rs",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.5",
    "@emnapi/runtime": "^2.0.0-alpha.5",
    "@napi-rs/cli": "^3.9.1",
    "@napi-rs/wasm-runtime": "^1.2.4",
    "@oxc-node/core": "^1.0.0",
    "@tybys/wasm-util": "^0.10.4",
    "@types/node": "^26.6.6",
    "ava": "^8.0.1",
    "chalk": "^6.0.0",
    "emnapi": "^2.0.0-alpha.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "tinybench": "^6.2.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
